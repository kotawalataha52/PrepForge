# PrepForge Frontend Environment Variables

# URL of your deployed backend (e.g. Render, Railway, Heroku, or VPS)
# When deploying to Vercel/Netlify, set this environment variable:
VITE_API_URL=https://your-prepforge-backend.onrender.com/api

# (Optional) WebSocket URL if different from backend URL:
# VITE_SOCKET_URL=https://your-prepforge-backend.onrender.com
